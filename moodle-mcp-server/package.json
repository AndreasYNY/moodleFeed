{
  "name": "moodle-mcp-server",
  "version": "1.0.0",
  "description": "Standalone MCP server for Moodle web services",
  "type": "module",
  "bin": {
    "moodle-mcp": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --compile --outfile moodle-mcp",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "~5.7.2",
    "zod": "^4.6.0"
  }
}
